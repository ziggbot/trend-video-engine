{
  "name": "trend-video-engine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Faceless content ecosystem: Google Trends -> scripts -> shorts/long-form videos/Instagram posts -> ready-to-post packages.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "run": "tsx src/cli.ts run",
    "run:mock": "tsx src/cli.ts run --mock",
    "approve": "tsx src/cli.ts approve",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:smoke": "vitest run --project smoke",
    "test:all": "vitest run"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.0",
    "@remotion/captions": "^4.0.0",
    "@remotion/renderer": "^4.0.0",
    "edge-tts-universal": "^1.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0",
    "sharp": "^0.34.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
